# Nyna Connect — Notification configuration template.
# Copy this file to ".env" (backend) or provide the values below, then
# run your app with them. DO NOT commit real secrets.

# ── Firebase Cloud Messaging (FCM) ──────────────────────────────────────────
# Legacy API key for the FCM provider. Read by:
#   - my_dart_backend  (routes/notifications/index.dart)
#   - social_support_app (lib/services/notification_sender.dart, dev only)
# You can pass it at runtime via --dart-define=FCM_SERVER_KEY=... too.
FCM_SERVER_KEY=your_fcm_server_key_here

# ── SendGrid ────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Verified "from" address for SendGrid; must match your SendGrid sender identity.
EMAIL_FROM=no-reply@nynaconnect.app